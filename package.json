{
  "name": "sprechfunk-uebung",
  "version": "1.0.0",
  "description": "Kostenloser Open-Source-Übungsgenerator für BOS-Sprechfunkübungen im Katastrophenschutz (THW, Feuerwehr, Rettungsdienst): verteilt Funksprüche, erzeugt Meldevordruck und Nachrichtenvordruck als PDF und begleitet die Übung live.",
  "keywords": [
    "sprechfunk",
    "sprechfunkuebung",
    "funkuebung",
    "bos",
    "bos-funk",
    "katastrophenschutz",
    "bevoelkerungsschutz",
    "thw",
    "feuerwehr",
    "rettungsdienst",
    "sprechfunkausbildung",
    "meldevordruck",
    "nachrichtenvordruck",
    "uebungsgenerator"
  ],
  "homepage": "https://github.com/wattnpapa/sprechfunk-uebung#readme",
  "bugs": {
    "url": "https://github.com/wattnpapa/sprechfunk-uebung/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wattnpapa/sprechfunk-uebung.git"
  },
  "license": "EUPL-1.2",
  "author": {
    "name": "Johannes Rudolph",
    "email": "johannes.rudolph@thw-oldenburg.de"
  },
  "type": "module",
  "main": "app.js",
  "scripts": {
    "build": "rollup -c && node scripts/postbuild-copy.mjs && node scripts/generate-embed.mjs && node scripts/generate-pdfs.mjs",
    "watch": "chokidar \"src/**/*\" \"assets/**/*\" \"rollup.config.js\" -c \"npm run build\"",
    "serve": "serve dist -l tcp://127.0.0.1:3000",
    "start": "npm run build && npm run serve",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "mkdir -p test-results && vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test -g \"@smoke\"",
    "test:e2e:generator": "playwright test -g \"@generator\"",
    "test:e2e:admin": "playwright test -g \"@admin\"",
    "test:e2e:teilnehmer": "playwright test -g \"@teilnehmer\"",
    "test:e2e:uebungsleitung": "playwright test -g \"@uebungsleitung\"",
    "test:e2e:routing": "playwright test -g \"@routing\"",
    "test:e2e:split": "npm run test:e2e:smoke && npm run test:e2e:generator && npm run test:e2e:admin && npm run test:e2e:teilnehmer && npm run test:e2e:uebungsleitung && npm run test:e2e:routing && npm run test:e2e:seo",
    "coverage:readme": "node scripts/update-coverage-link.mjs",
    "og:image": "node scripts/generate-og-images.mjs",
    "anleitung:screenshots": "node scripts/generate-anleitung-screenshots.mjs",
    "deps:audit": "npm audit --omit=dev --audit-level=high",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test:e2e:seo": "playwright test -g \"@seo\"",
    "links:check": "node scripts/check-internal-links.mjs --strict",
    "content:check": "node scripts/check-content-quality.mjs --strict",
    "bilder:webp": "node scripts/generate-webp.mjs",
    "cls:check": "node scripts/check-cls.mjs",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "embed": "node scripts/generate-embed.mjs",
    "backlinks:report": "node scripts/seo-backlinks.mjs",
    "outreach:check": "node scripts/check-outreach.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bootstrap": "^5.2.11",
    "@types/chart.js": "^4.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jspdf": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.5.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "crypto-js": "^4.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "rollup": "^4.62.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "serve": "^14.2.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fontsource-variable/antonio": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "@types/marked": "^6.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "marked": "^18.0.9",
    "pdfjs-dist": "^6.2.108"
  },
  "overrides": {
    "braces": "3.0.3",
    "tar": "7.5.7"
  }
}
