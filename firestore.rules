rules_version = '2';

// Sicherheitsregeln für den Sprechfunk-Übungsgenerator.
//
// ACHTUNG – bewusst gewähltes Sicherheitsmodell:
// Die Anwendung kennt keine Authentifizierung. Übungsleitung, Teilnehmer und
// Admin-Ansicht sind reine Client-Routen ohne Login. Diese Regeln können daher
// keinen Aufrufer unterscheiden; sie leisten:
//   * Whitelist der Collection: außerhalb von /uebungen/{id} ist nichts erlaubt.
//   * Strukturprüfung beim Schreiben: nur bekannte Felder, korrekte Typen,
//     begrenzte Stringlängen und Listengrößen.
//   * Schutz der Dokument-ID gegen Umschreiben.
//   Beim Erweitern das Ausdrucks-Budget beachten (Kommentar vor
//   istGueltigeUebung).
//
// Bekannte Restrisiken (nicht durch Regeln abgedeckt):
//   1. Jeder mit dem öffentlichen API-Key kann Übungen lesen, anlegen und
//      LÖSCHEN. Der Übungscode ist ein Auffindbarkeits-, kein Zugriffsschutz.
//   2. Eine unbegrenzte list-Abfrage kann die gesamte Collection abziehen.
//      Ein `request.query.limit`-Gate ist hier nicht gesetzt, weil die
//      Aggregations-Queries des Admin-Dashboards (count/sum) ohne Limit laufen.
// Beides ließe sich nur mit einem Identitätsbegriff schließen — anonyme
// Firebase-Auth plus Custom Claim für die Admin-Rolle, ergänzt um App Check
// gegen Fremdclients. Bis dahin gilt: keine personenbezogenen oder sonst
// schützenswerten Daten in Übungen erfassen.

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-Deny. Steht hier zur Dokumentation der Absicht; Firestore
    // verweigert ohnehin alles, wofür keine allow-Regel greift.
    match /{document=**} {
      allow read, write: if false;
    }

    match /uebungen/{uebungId} {
      allow get, list: if true;

      allow create: if istGueltigeUebung(request.resource.data)
                    && request.resource.data.id == uebungId;

      allow update: if istGueltigeUebung(request.resource.data)
                    && request.resource.data.id == uebungId
                    && request.resource.data.id == resource.data.id;

      // Siehe Restrisiko 1: ohne Identität nicht weiter einschränkbar.
      allow delete: if true;

      // Live-Sync des Übungsstatus (ADR 0006). Je ein Dokument pro Teilnehmer
      // plus leitung-public (Bestätigungen) und leitung (interne Notizen).
      // Ohne Identität lässt sich nicht erzwingen, dass nur der jeweilige
      // Teilnehmer sein Dokument schreibt; geprüft werden Dokument-ID und
      // Struktur. Löschen ist nicht vorgesehen — Zurücksetzen schreibt Marker.
      match /status/{statusId} {
        allow get, list: if true;

        allow create, update: if istBekanntesStatusDokument(statusId)
                              && istGueltigerStatus(request.resource.data);

        allow delete: if false;
      }

      // Andere Unterkollektionen nutzt die Anwendung nicht.
      match /{unterpfad=**} {
        allow read, write: if false;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Hilfsfunktionen
// ---------------------------------------------------------------------------

// Feldliste synchron halten mit FunkUebung.toJson() und
// FirebaseService.buildStatistikFelder(). Der Vertragstest
// tests/services/FirestoreRules.contract.test.ts schlägt fehl, sobald ein
// tatsächlich gespeichertes Feld hier nicht aufgeführt ist.
function erlaubteFelder() {
  return [
    'id', 'uebungCode', 'checksumme', 'createDate', 'name', 'datum',
    'rufgruppe', 'leitung', 'buildVersion', 'teilnehmerListe', 'teilnehmerIds',
    'teilnehmerStellen', 'nachrichten', 'loesungswoerter', 'loesungsStaerken',
    'spruecheProTeilnehmer', 'spruecheAnAlle', 'spruecheAnMehrere',
    'buchstabierenAn', 'anmeldungAktiv', 'nachrichtenArtAktiv',
    'spruchAnteilProzent', 'verwendeteVorlagen',
    'istStandardKonfiguration', 'spielModus', 'xZeitIntervallMinuten',
    'xZeitStartOffsetMinuten', 'szenarioSlug', 'fuehrungsstelle', 'seed',
    'statTeilnehmerAnzahl', 'statNachrichtenAnzahl',
    'statBytes', 'statMonat', 'statJahr', 'statHatLoesungswoerter',
    'statHatLoesungsStaerken', 'statHatBuchstabieren'
  ];
}

function pflichtFelder() {
  return [
    'id', 'uebungCode', 'name', 'datum', 'createDate', 'teilnehmerListe',
    'teilnehmerIds', 'nachrichten'
  ];
}

function istText(wert, maxLaenge) {
  return wert is string && wert.size() <= maxLaenge;
}

// Datum liegt je nach Speicherpfad als ISO-String oder als Timestamp vor.
function istZeitpunkt(wert) {
  return wert is timestamp || (wert is string && wert.size() <= 40);
}

function istZahlImBereich(wert, min, max) {
  return wert is number && wert >= min && wert <= max;
}

// ---------------------------------------------------------------------------
// Ausdrucks-Budget: Firestore wertet höchstens 1000 Ausdrücke je Anfrage aus
// und lehnt darüber mit PERMISSION_DENIED ab — ohne Hinweis im Client.
// Jeder Knoten zählt (Literal, Feldzugriff, Aufruf, Operator), Funktions-
// argumente werden mitgezählt. Am 2026-09-30 kippte ein zusätzliches
// optionales Feld jedes Speichern in Produktion: Der frühere Helfer für
// optionale Felder nahm die Bedingung als Argument entgegen und prüfte die
// Anwesenheit über `keys()` plus `hasAny` — rund 30 Ausdrücke je Feld, mal 27.
//
// Im Emulator gemessen (tests/rules/FirestoreRules.emulator.test.ts misst
// die Reserve bei jedem Lauf):
//   `'feld' in daten`                                  ≈ 3
//   `daten.feld is bool`                               ≈ 4
//   `daten.feld is string && daten.feld.size() <= n`   ≈ 10
//   `… is number && … >= a && … <= b`                  ≈ 16
//   Aufruf einer Hilfsfunktion zusätzlich              ≈ 4 je Aufruf
// Deshalb stehen die Prüfungen der Übungsfelder unten ausgeschrieben statt
// über Hilfsfunktionen, verteilt auf kleine Gruppen (der Compiler lehnt zu
// lange Ketten als „too complex" ab). Richtwert je neuem optionalen Feld:
// 10 bis 20 Ausdrücke.
// ---------------------------------------------------------------------------

function istGueltigeUebung(daten) {
  return daten.keys().hasOnly(erlaubteFelder())
         && daten.keys().hasAll(pflichtFelder())
         && daten.id is string && daten.id.size() <= 64
         && daten.uebungCode.matches('^[A-Z0-9]{6}$')
         && daten.name is string && daten.name.size() <= 200
         && (daten.datum is timestamp || (daten.datum is string && daten.datum.size() <= 40))
         && (daten.createDate is timestamp || (daten.createDate is string && daten.createDate.size() <= 40))
         && daten.teilnehmerListe is list && daten.teilnehmerListe.size() <= 100
         && daten.teilnehmerIds is map && daten.teilnehmerIds.size() <= 100
         && daten.nachrichten is map && daten.nachrichten.size() <= 100
         && sindOptionaleTexteGueltig(daten)
         && sindOptionaleSchalterGueltig(daten)
         && sindOptionaleZahlenGueltig(daten)
         && sindStatistikFelderGueltig(daten)
         // Rollenbesetzung einer Führungsstellen-Übung; das Drehbuch selbst
         // liegt als statisches JSON im Deployment, im Dokument stehen nur
         // Slug, Funkrufnamen und Stellennamen.
         && (!('fuehrungsstelle' in daten) || istFuehrungsstelle(daten.fuehrungsstelle));
}

function sindOptionaleTexteGueltig(daten) {
  return (!('checksumme' in daten) || (daten.checksumme is string && daten.checksumme.size() <= 64))
         && (!('rufgruppe' in daten) || (daten.rufgruppe is string && daten.rufgruppe.size() <= 100))
         && (!('leitung' in daten) || (daten.leitung is string && daten.leitung.size() <= 100))
         && (!('buildVersion' in daten) || (daten.buildVersion is string && daten.buildVersion.size() <= 64))
         // Seed der Nachrichtenverteilung. Offen lesbar und damit kein Geheimnis
         // — die Zugangscodes werden bewusst nicht daraus abgeleitet.
         && (!('seed' in daten) || (daten.seed is string && daten.seed.size() <= 64))
         // Slug des Szenarios (Szenario-Modus); Inhalte liegen als statisches
         // JSON im Deployment, im Dokument steht nur die Referenz.
         && (!('szenarioSlug' in daten) || (daten.szenarioSlug is string && daten.szenarioSlug.size() <= 64))
         && (!('teilnehmerStellen' in daten) || daten.teilnehmerStellen is map)
         && (!('loesungswoerter' in daten) || daten.loesungswoerter is map)
         && (!('loesungsStaerken' in daten) || daten.loesungsStaerken is map)
         && (!('verwendeteVorlagen' in daten) || (daten.verwendeteVorlagen is list
                                                  && daten.verwendeteVorlagen.size() <= 50));
}

function sindOptionaleSchalterGueltig(daten) {
  return (!('anmeldungAktiv' in daten) || daten.anmeldungAktiv is bool)
         && (!('istStandardKonfiguration' in daten) || daten.istStandardKonfiguration is bool)
         && (!('spielModus' in daten) || daten.spielModus in ['klassisch', 'xZeit']);
}

function sindOptionaleZahlenGueltig(daten) {
  return (!('spruecheProTeilnehmer' in daten)
          || (daten.spruecheProTeilnehmer is number && daten.spruecheProTeilnehmer >= 0 && daten.spruecheProTeilnehmer <= 1000))
         && (!('spruecheAnAlle' in daten)
             || (daten.spruecheAnAlle is number && daten.spruecheAnAlle >= 0 && daten.spruecheAnAlle <= 1000))
         && (!('spruecheAnMehrere' in daten)
             || (daten.spruecheAnMehrere is number && daten.spruecheAnMehrere >= 0 && daten.spruecheAnMehrere <= 1000))
         && (!('buchstabierenAn' in daten)
             || (daten.buchstabierenAn is number && daten.buchstabierenAn >= 0 && daten.buchstabierenAn <= 1000))
         && (!('xZeitIntervallMinuten' in daten)
             || (daten.xZeitIntervallMinuten is number && daten.xZeitIntervallMinuten >= 0 && daten.xZeitIntervallMinuten <= 1440))
         && (!('xZeitStartOffsetMinuten' in daten)
             || (daten.xZeitStartOffsetMinuten is number && daten.xZeitStartOffsetMinuten >= 0 && daten.xZeitStartOffsetMinuten <= 1440));
}

function istFuehrungsstelle(wert) {
  return wert is map
         && wert.keys().hasOnly(['slug', 'beuebteStelle', 'uebergeordnet', 'unterstellt', 'beginn', 'stellen'])
         && wert.keys().hasAll(['slug', 'beuebteStelle', 'uebergeordnet', 'unterstellt'])
         && wert.slug is string && wert.slug.size() <= 64
         && wert.beuebteStelle is string && wert.beuebteStelle.size() <= 100
         && wert.uebergeordnet is string && wert.uebergeordnet.size() <= 100
         && wert.unterstellt is list && wert.unterstellt.size() <= 8
         && (!('beginn' in wert) || (wert.beginn is string && wert.beginn.size() <= 5))
         // Stellenname je Funkrufname; höchstens eine Stelle je Rolle (1 + 8 + 1).
         && (!('stellen' in wert) || (wert.stellen is map && wert.stellen.size() <= 10));
}

// Die stat*-Felder speisen die Aggregations-Queries des Admin-Dashboards.
// Werden sie manipuliert, sind nur die Kennzahlen falsch — trotzdem eng führen.
function sindStatistikFelderGueltig(daten) {
  return (!('statTeilnehmerAnzahl' in daten)
          || (daten.statTeilnehmerAnzahl is number && daten.statTeilnehmerAnzahl >= 0 && daten.statTeilnehmerAnzahl <= 100))
         && (!('statNachrichtenAnzahl' in daten)
             || (daten.statNachrichtenAnzahl is number && daten.statNachrichtenAnzahl >= 0 && daten.statNachrichtenAnzahl <= 100000))
         && (!('statBytes' in daten)
             || (daten.statBytes is number && daten.statBytes >= 0 && daten.statBytes <= 5000000))
         && (!('statMonat' in daten) || (daten.statMonat is number && daten.statMonat >= 0 && daten.statMonat <= 11))
         && (!('statJahr' in daten) || (daten.statJahr is number && daten.statJahr >= 1970 && daten.statJahr <= 2200))
         && (!('statHatLoesungswoerter' in daten) || daten.statHatLoesungswoerter is bool)
         && (!('statHatLoesungsStaerken' in daten) || daten.statHatLoesungsStaerken is bool)
         && (!('statHatBuchstabieren' in daten) || daten.statHatBuchstabieren is bool);
}

// ---------------------------------------------------------------------------
// Live-Sync des Übungsstatus (ADR 0006)
// ---------------------------------------------------------------------------

// Dokument-IDs synchron halten mit src/types/LiveStatus.ts.
function istBekanntesStatusDokument(statusId) {
  return statusId == 'leitung'
         || statusId == 'leitung-public'
         || statusId.matches('^teilnehmer-[A-Za-z0-9]{1,32}$');
}

function erlaubteStatusFelder() {
  return [
    'version', 'lastUpdated',
    // teilnehmer-<id>
    'teilnehmerId', 'teilnehmer', 'nachrichten', 'xZeitBasis', 'xZeitBasisGeaendertUm',
    // leitung
    'nachrichtenNotizen'
  ];
}

function istGueltigerStatus(daten) {
  return daten.keys().hasOnly(erlaubteStatusFelder())
         && daten.keys().hasAll(['version', 'lastUpdated'])
         && istZahlImBereich(daten.version, 1, 100)
         && istZeitpunkt(daten.lastUpdated)
         && (!('teilnehmerId' in daten) || istText(daten.teilnehmerId, 32))
         // `teilnehmer` ist im Teilnehmer-Dokument der Funkrufname, im
         // leitung-Dokument die Statusliste je Teilnehmer.
         && (!('teilnehmer' in daten) || istText(daten.teilnehmer, 100)
                                       || (daten.teilnehmer is map
                                           && daten.teilnehmer.size() <= 100))
         && (!('xZeitBasis' in daten) || istText(daten.xZeitBasis, 5))
         && (!('xZeitBasisGeaendertUm' in daten) || istZeitpunkt(daten.xZeitBasisGeaendertUm))
         // Obergrenzen wie bei den Übungsdaten: 100 Teilnehmer, 100 Nachrichten.
         && (!('nachrichten' in daten) || (daten.nachrichten is map
                                           && daten.nachrichten.size() <= 10000))
         && (!('nachrichtenNotizen' in daten) || (daten.nachrichtenNotizen is map
                                                  && daten.nachrichtenNotizen.size() <= 10000));
}
